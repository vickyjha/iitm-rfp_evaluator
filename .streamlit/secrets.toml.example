# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud -> App settings -> Secrets. Never commit real keys.
# Everything here is optional: without a key the app starts in mock mode, and users can
# enter their own OpenAI key on the AI engine page (kept in their browser session only).

# OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL = "gpt-4o-mini"         # default model when a key is set here
# LLM_MODE = "mock"                    # start in mock mode even if a key is set

# LangSmith tracing
# LANGSMITH_API_KEY = "lsv2_..."
# LANGSMITH_TRACING = "true"
# LANGSMITH_PROJECT = "rfp-evaluator"

# Initial passwords for the demo accounts (applied until the user changes their password in the app)
# EVALUATOR_PASSWORD = "change-me-1"
# REVIEWER_PASSWORD = "change-me-2"
